# /etc/reybasar/reybasar.env  (permisos 600, dueño root)
REYBASAR_DATABASE_URL=sqlite:////srv/reybasar/data/reybasar.db
REYBASAR_MEDIA_DIR=/srv/reybasar/media
# Copias de INE de los contratos: privadas, NUNCA dentro de media/
REYBASAR_PRIVADO_DIR=/srv/reybasar/data/privado
# Genera una con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
REYBASAR_SECRET_KEY=
# Tu correo: solo este nace administrador al registrarse (después haces admin a Cristina desde Usuarios)
REYBASAR_ADMINS=
# Mismo token que REYBASAR_BOT_TOKEN en el .env del bot. Genera uno igual que la clave secreta.
REYBASAR_BOT_TOKEN=
# Misma clave de OpenAI que usa el bot (para "Llenar con IA" en el admin)
OPENAI_API_KEY=
REYBASAR_WHATSAPP=527773525475
REYBASAR_TELEFONO=(777) 352 54 75
REYBASAR_FACEBOOK=https://www.facebook.com/ReyBasarOnline
REYBASAR_ENTREGA_CIUDAD=Cuernavaca
# NO poner REYBASAR_DEMO en producción
