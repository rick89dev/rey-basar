[Unit]
Description=ReyBasar (tienda)
After=network.target

[Service]
User=reybasar
Group=reybasar
WorkingDirectory=/srv/reybasar/app
EnvironmentFile=/etc/reybasar/reybasar.env
ExecStart=/srv/reybasar/app/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8020 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3
# Seguridad: solo puede escribir en datos y fotos
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/srv/reybasar/data /srv/reybasar/media

[Install]
WantedBy=multi-user.target
